{
  "manifest_version": 3,
  "name": "SulcusAI",
  "version": "0.1.0",
  "description": "Lets the SulcusAI app on this PC use tabs in this browser while you watch. It asks you before anything is submitted, bought or sent, and never types passwords or card numbers.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "tabGroups"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "SulcusAI",
    "default_icon": {
      "128": "icon.png"
    }
  }
}
