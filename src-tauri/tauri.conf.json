{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SulcusAI",
  "version": "1.0.0",
  "identifier": "app.sulcusai.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SulcusAI",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disk-cache-size=104857600",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob: https:; media-src 'self' blob: data: https: sulcusmedia: http://sulcusmedia.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost data: blob:; frame-src http://127.0.0.1:* http://localhost:* blob: data: https://www.youtube-nocookie.com https://player.vimeo.com https://www.dailymotion.com https://streamable.com https://www.loom.com https://player.twitch.tv https://clips.twitch.tv"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5MzgyNzZCMDA1MEMwQUUKUldTdXdGQUFheWM0aWRpYStpRDgyN3YvUkMwQ2tQNUs1Y0ZlaXkzMXpOQlZkWUVhQktjMEJkaTEK",
      "endpoints": ["https://github.com/IsaacLeh1/sulcusai/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
